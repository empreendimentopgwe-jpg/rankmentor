# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o arquivo ".env" para o Git / repositório público.

# Porta em que o servidor vai rodar
PORT=3000

# Segredo para assinar os tokens de login (gere uma string aleatória longa)
JWT_SECRET=troque_por_um_segredo_bem_grande_e_aleatorio

# Chave de API da NexusPag (fica só no servidor, nunca no navegador)
NEXUSPAG_API_KEY=nxp_live_a089b1f...

# URL base da API da NexusPag
NEXUSPAG_BASE_URL=https://nexuspag.com/api

# URL pública do seu BACKEND (Railway), usada como webhook_url na verificação KYC
PUBLIC_APP_URL=https://mentor-rank-api.up.railway.app

# URL(s) do seu FRONT-END (Netlify) que podem chamar essa API. Separe por vírgula.
ALLOWED_ORIGINS=https://meuapp.netlify.app
